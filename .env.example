# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (used for sitemap.xml and canonical URLs).
APP_URL="MY_APP_URL"

# Optional: Point frontend directly to your live cPanel PHP/MySQL API (leave blank to use built-in preview /api)
# Example: VITE_API_BASE_URL="https://mondalexportimport.com/api"
VITE_API_BASE_URL=""

# Preview Server Admin Credentials (change before production deployment)
ADMIN_EMAIL="admin@mondalexportimport.com"
ADMIN_PASSWORD="MondalExport@2026"
ADMIN_TOKEN_SECRET="change-this-to-a-long-random-secret"

# Optional email delivery for /api/enquiry (delivered to info@mondalexportimport.com)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="enquiries@mondalexportimport.com"

# Optional Google Sheet / CRM webhook URL for enquiry logging
ENQUIRY_WEBHOOK_URL=""
